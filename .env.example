# PersonaLattice never commits real credentials.
# Copy these values into local/deployment secrets and replace placeholders.

# Browser -> same-origin Next.js proxy. This value is safe to expose client-side.
NEXT_PUBLIC_API_URL=/api

# Next.js server -> private FastAPI origin. Do not expose internal credentials here.
PERSONALATTICE_API_ORIGIN=http://127.0.0.1:8000

# Exactly one private operator account. Store only an Argon2id hash, never plaintext.
PERSONALATTICE_ADMIN_USERNAME=admin
PERSONALATTICE_ADMIN_PASSWORD_HASH=
PERSONALATTICE_SESSION_SECONDS=28800
PERSONALATTICE_COOKIE_SECURE=false
PERSONALATTICE_SESSION_COOKIE=personalattice_session

# Private retained research cases and short-lived upload-review candidate state.
# Raw uploaded files and extracted document text are not retained in this database.
PERSONALATTICE_DB_PATH=./personalattice.db
PERSONALATTICE_CASE_RETENTION_DAYS=30
PERSONALATTICE_UPLOAD_REVIEW_RETENTION_HOURS=24

# Optional provider credentials. Missing credentials keep the matching source unavailable
# without a provider attempt. OPENALEX_API_KEY is a free server-side key for exact author URLs.
NUMVERIFY_API_KEY=
ABSTRACT_PHONE_API_KEY=
IPQS_API_KEY=
BRAVE_SEARCH_API_KEY=
OPENALEX_API_KEY=

# Optional AI provider. Do not put a real key in Git or client-side variables.
OPENAI_API_KEY=

# Copy to /etc/persona-lattice/production.env and chmod 600.
# Never commit real values.
PERSONALATTICE_ADMIN_USERNAME=admin
PERSONALATTICE_ADMIN_PASSWORD_HASH=
PERSONALATTICE_SESSION_SECONDS=28800
PERSONALATTICE_COOKIE_SECURE=true
PERSONALATTICE_SESSION_COOKIE=__Host-personalattice_session
PERSONALATTICE_DB_PATH=/var/lib/persona-lattice/data/personalattice.db
PERSONALATTICE_CASE_RETENTION_DAYS=30
PERSONALATTICE_UPLOAD_REVIEW_RETENTION_HOURS=24

# Optional governed provider credentials. Leave blank to fail closed.
NUMVERIFY_API_KEY=
ABSTRACT_PHONE_API_KEY=
IPQS_API_KEY=
BRAVE_SEARCH_API_KEY=
OPENALEX_API_KEY=
COMPANIES_HOUSE_API_KEY=
OPENAI_API_KEY=
